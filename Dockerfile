# EAGLE LIVE - projeto completo em UM arquivo para upload pelo celular.
# Envie este arquivo com o nome exato Dockerfile para a raiz do GitHub.
# Render: New > Web Service > repositorio > Language: Docker > Free.
# Environment: ADMIN_PASSWORD com pelo menos 12 caracteres.
# Dockerfile Path: ./Dockerfile. Docker Command: vazio (usa CMD abaixo).
# Depois abra o site e importe sua M3U original pelo celular.
# Nao inclui lista privada, senha do provedor ou chave SSH.
# Buffer controlado nao garante remover atraso da fonte.
# No Render Free, reimporte a M3U apos reinicios.
# O build recria os arquivos abaixo e instala as dependencias pelo npm.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN node -e 'const fs=require("node:fs"),path=require("node:path");const files={"package.json":"","package-lock.json":"","lib.mjs":"","server.mjs":"","public/index.html":"","public/app.js":"","public/style.css":"","test/core.test.mjs":"","test/integration.test.mjs":""};for(const [name,data] of Object.entries(files)){fs.mkdirSync(path.dirname(name),{recursive:true});fs.writeFileSync(name,Buffer.from(data,"base64"));}'
RUN npm ci --omit=dev && npm test
RUN mkdir -p /app/data && chown -R node:node /app
USER node
ENV NODE_ENV=production PORT=10000 DATA_DIR=/app/data MAX_STREAMS=1
EXPOSE 10000
CMD ["node", "server.mjs"]
