# EAGLE M3U RELAY v2 - SOMENTE retransmissor. Sem site/player e sem login.
# 1. Envie apenas este Dockerfile a raiz do GitHub, substituindo o anterior.
# 2. Render: Web Service, Language Docker, Dockerfile Path ./Dockerfile.
#    Docker Command vazio. Nao precisa de ADMIN_PASSWORD.
# 3. Environment > Secret Files > Add Secret File.
#    Filename: EAGLE_VLC.m3u. Contents: conteudo da sua M3U ORIGINAL.
#    Save Changes. A lista e lida de /etc/secrets/EAGLE_VLC.m3u no inicio.
# 4. Abra a URL HTTPS do servico + /canais.m3u no seu aplicativo IPTV.
# A lista privada NAO esta neste arquivo. Nao publique a M3U original no GitHub.
# Fonte: https://render.com/docs/configure-environment-variables#secret-files
# Este servidor e publico: quem tiver o endereco podera assistir.
# Nao existe API publica para alterar a lista ou escolher URLs de origem.
# Padrao: 1 canal simultaneo, ate 8 espectadores. MAX_STREAMS pode ser 1 a 4.
# FFmpeg copia codecs sem recodificar; saida TS continua, sem nova segmentacao HLS.
# Fila HTTP limitada a aproximadamente 256 KiB mais um bloco e buffers de rede.
# Clientes lentos sao desconectados; o aplicativo receptor controla reconexao.
# EXT-VLC de 300ms e apenas sugestao ao VLC, nao garantia de atraso total.
# Preserva o atraso existente na fonte; pode adicionar atraso no trajeto Render.
# Nao foram substituidas fontes nem medido atraso real dos canais do provedor.
# Render Free tem limites de CPU, banda e suspensao. Nao garante uso continuo.
# Teste com sinal sintetico HTTP + FFmpeg/FFprobe incluido no build.
# Nao foi executado deploy nem build Docker neste ambiente de entrega.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN node -e 'const fs=require("node:fs"),path=require("node:path");const files={"package.json":"eyJuYW1lIjoiZWFnbGUtbTN1LXJlbGF5IiwidmVyc2lvbiI6IjIuMC4wIiwicHJpdmF0ZSI6dHJ1ZSwidHlwZSI6Im1vZHVsZSIsInNjcmlwdHMiOnsic3RhcnQiOiJub2RlIHNlcnZlci5tanMiLCJ0ZXN0Ijoibm9kZSAtLXRlc3QifSwiZW5naW5lcyI6eyJub2RlIjoiPj0yMiJ9fQo=","lib.mjs":"","server.mjs":"","test/core.test.mjs":"","test/integration.test.mjs":""};for(const [name,data] of Object.entries(files)){fs.mkdirSync(path.dirname(name),{recursive:true});fs.writeFileSync(name,Buffer.from(data,"base64"));}'
RUN npm test
USER node
ENV NODE_ENV=production PORT=10000 MAX_STREAMS=1
EXPOSE 10000
CMD ["node", "server.mjs"]
